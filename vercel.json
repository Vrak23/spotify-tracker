{
  "version": 2,
  "routes": [
    {
      "src": "/login",
      "dest": "/api/index.js"
    },
    {
      "src": "/callback",
      "dest": "/api/index.js"
    },
    {
      "src": "/refresh_token",
      "dest": "/api/index.js"
    },
    {
      "src": "/(.*)",
      "dest": "/public/$1"
    }
  ]
}
