{
  "version": 2,
  "rewrites": [
    {
      "source": "/login",
      "destination": "/api/index.js"
    },
    {
      "source": "/callback",
      "destination": "/api/index.js"
    },
    {
      "source": "/refresh_token",
      "destination": "/api/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/public/$1"
    }
  ]
}
